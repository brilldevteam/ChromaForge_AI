# Copy to .env in this application root and edit the private key there.
# Start locally with: php -S 127.0.0.1:8000 router.php
# Apply server/cloudpanel-security.conf in CloudPanel before deploying .env.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
CHROMAFORGE_AI_IP_PER_MINUTE=10
CHROMAFORGE_AI_IP_PER_DAY=30
CHROMAFORGE_AI_GLOBAL_PER_DAY=200
# Empty uses the automatic quota directory outside the public app folder.
CHROMAFORGE_AI_STATE_DIR=
